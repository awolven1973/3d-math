(defpackage :3dm.port-tests (:use :cl) (:export #:run-tests))
(in-package :3dm.port-tests)

(defun near (a b &optional (tolerance 1d-6))
  (<= (abs (- a b)) tolerance))

(defun check-vector (v values)
  (assert (every #'near (3dm::port-components v) values))
  (assert (= (length (3dm::port-components v)) (length values)))
  v)

(defun test-clampf ()
  (flet ((check (input expected)
           (let ((actual (3dm-def::clampf input)))
             (assert (typep actual 'single-float))
             (assert (= actual expected))
             (assert (= (float-sign actual) (float-sign expected))))))
    (check 0 0.0f0)
    (check 0.0f0 0.0f0)
    (check -0.0f0 -0.0f0)
    (check 0.0d0 0.0f0)
    (check -0.0d0 -0.0f0)
    (check 3/2 1.5f0)
    (check -3/2 -1.5f0)
    (let ((least (rational least-positive-single-float)))
      (dolist (factor '(1/4 1/2 3/4 1))
        (let* ((x (* least factor))
               (expected (if (<= factor 1/2) 0.0f0
                             least-positive-single-float)))
          (check x expected)
          (check (- x) (- expected))
          (check (coerce x 'double-float) expected)
          (check (coerce (- x) 'double-float) (- expected)))))
    (let ((max (rational most-positive-single-float)))
      (dolist (x (list max (+ max 1/3) (/ (expt 2 200) 3)
                       (expt 2 200) most-positive-double-float))
        (check x most-positive-single-float)
        (check (- x) most-negative-single-float)))))

(defun test-vulkan-projections ()
  ;; Check both matrix entries and transformed homogeneous coordinates.
  ;; Asymmetric bounds catch transposition, translation and Y-sign mistakes.
  (dolist (spec (list (list 'single-float #'3dm.f:mperspective-vulkan
                           #'3dm.f:mortho-vulkan #'3dm.f:vec4 2d-6)
                     (list 'double-float #'3dm.d:mperspective-vulkan
                           #'3dm.d:mortho-vulkan #'3dm.d:vec4 1d-12)))
    (destructuring-bind (precision perspective ortho vec4 tolerance) spec
      (flet ((check-matrix (m expected)
               (assert (typep m '3dm.coalton:mat4))
               (let ((entries (3dm::port-matrix-elements m)))
                 (assert (= (length entries) 16))
                 (assert (every (lambda (x) (typep x precision)) entries))
                 (assert (every (lambda (a b) (near a b tolerance))
                                entries expected))))
             (check-projection (m point expected-w expected)
               (let* ((clip (3dm:m* m (apply vec4 point)))
                      (w (3dm:vw clip)))
                 (assert (near w expected-w tolerance))
                 (assert (every (lambda (a b) (near a b tolerance))
                                (list (/ (3dm:vx clip) w)
                                      (/ (3dm:vy clip) w)
                                      (/ (3dm:vz clip) w))
                                expected)))))
        (let ((p (funcall perspective 90 2 1 11)))
          (check-matrix p '(1/2 0 0 0  0 -1 0 0
                            0 0 -11/10 -11/10  0 0 -1 0))
          (check-projection p '(0 0 -1 1) 1 '(0 0 0))
          (check-projection p '(0 0 -11 1) 11 '(0 0 1))
          (check-projection p '(2 1 -1 1) 1 '(1 -1 0))
          (check-projection p '(-22 -11 -11 1) 11 '(-1 1 1))
          (check-projection p '(0 0 -2 1) 2 '(0 0 11/20)))
        ;; Nontrivial FOV: compare directly with the original KRMA formula.
        (let* ((p (funcall perspective 53 7/5 1/4 500))
               (n (coerce 1/4 precision))
               (f (coerce 500 precision))
               (aspect (coerce 7/5 precision))
               (focal (/ (coerce 1 precision)
                         (coerce (tan (* 0.5d0 (* 53 (/ pi 180)))) precision)))
               (nf (- n f)))
          (check-matrix p (list (/ focal aspect) 0 0 0
                                0 (- focal) 0 0
                                0 0 (/ f nf) (/ (* n f) nf)
                                0 0 -1 0)))
        (let ((o (funcall ortho -2 6 -3 1 2 10)))
          (check-matrix o '(1/4 0 0 -1/2  0 -1/2 0 -1/2
                            0 0 -1/8 -1/4  0 0 0 1))
          (check-projection o '(-2 -3 -2 1) 1 '(-1 1 0))
          (check-projection o '(6 1 -10 1) 1 '(1 -1 1))
          (check-projection o '(2 -1 -6 1) 1 '(0 0 1/2)))))))

(defun run-tests ()
  (test-clampf)
  (test-vulkan-projections)
  (let* ((f (3dm.f:vec3 1 2 3)) (d (3dm.d:vec3 4 5 6))
         (r (3dm.rat:vec3 1/3 2/3 3/7)))
    (assert (eq (class-of f) (class-of d)))
    (assert (eq (class-of d) (class-of r)))
    (assert (typep f '3dm.coalton:vec3))
    (assert (typep (3dm:vx f) 'single-float))
    (assert (typep (3dm:vx d) 'double-float))
    (assert (= (3dm:vx r) 1/3))
    (assert (= (3dm:vx (3dm.f:vec3 most-positive-double-float 0 0)) most-positive-single-float))
    (check-vector (3dm:v+ f d) '(5 7 9))
    (check-vector (3dm:v- d f) '(3 3 3))
    (check-vector (3dm:v* d 2) '(8 10 12))
    (check-vector (3dm:v/ d 2) '(2 5/2 3))
    (assert (= (3dm:v. f d) 32))
    (assert (3dm:v= r (3dm.rat:vec3 1/3 2/3 3/7)))
    (check-vector (3dm:vc (3dm.d:vec3 1 0 0) (3dm.f:vec3 0 1 0)) '(0 0 1))
    (check-vector (3dm:vunit (3dm.d:vec3 3 4 0)) '(3/5 4/5 0))
    (check-vector (3dm:lerp f d 1/2) '(5/2 7/2 9/2))
    (let ((m (3dm.d:mat3 1 2 3 4 5 6 7 8 9)))
      (check-vector (3dm:m* m (3dm.d:vec3 2 3 4)) '(20 47 74))
      (check-vector (3dm:m* m (3dm.f:vec3 2 3 4)) '(20 47 74))
      (check-vector (3dm:mrow m 1) '(4 5 6))
      (check-vector (3dm:mcol m 1) '(2 5 8))
      (check-vector (3dm:mrow (3dm:mtranspose m) 1) '(2 5 8)))
    (let ((m (3dm.rat:mat2 1 2 3 4)))
      (assert (= (3dm:mdet m) -2))
      (assert (= (3dm::port-matrix-ref (3dm:minv m) 0 0) -2))
      (assert (equal (3dm::port-matrix-elements (3dm:m* m (3dm:minv m))) '(1 0 0 1))))
    (let* ((a (make-array '(2 3) :element-type 'single-float :initial-contents '((1f0 2f0 3f0) (4f0 5f0 6f0))))
           (b (make-array '(3 2) :element-type 'double-float :initial-contents '((7d0 8d0) (9d0 10d0) (11d0 12d0))))
           (c (3dm:m* a b)))
      (assert (equalp c #2A((58d0 64d0) (139d0 154d0)))))
    (let ((q (3dm:qrotation (3dm.d:vec3 0 0 1) (/ pi 2))))
      (check-vector (3dm:rotate-vector (3dm.d:vec3 1 0 0) q) '(0 1 0))
      (check-vector (3dm:quaternion-x-axis q) '(0 1 0))
      (check-vector (3dm:m* (3dm:matrix-from-quaternion q) (3dm.d:vec4 1 0 0 1)) '(0 1 0 1)))
    (let ((m (3dm.d:meye 4)))
      (assert (eq m (3dm:nmtranslate m (3dm.d:vec3 1 2 3))))
      (assert (eq m (3dm:nmscale m (3dm.d:vec3 2 3 4))))
      (check-vector (3dm:m* m (3dm.d:vec4 1 1 1 1)) '(3 5 7 1))))
  (format t "~&Coalton port smoke tests passed.~%")
  t)
