(defun components (x)
  (typecase x
    (3dm.d::mat2 (coerce (3dm.d::marr2 x) 'list))
    (3dm.d::vec2 (list (3dm.d::vx2 x) (3dm.d::vy2 x)))
    (3dm.f::vec2 (list (3dm.f::vx2 x) (3dm.f::vy2 x)))
    (3dm.f::mat2 (coerce (3dm.f::marr2 x) 'list))
    (3dm.d::mat3 (coerce (3dm.d::marr3 x) 'list))
    (3dm.d::vec3 (list (3dm.d::vx3 x) (3dm.d::vy3 x) (3dm.d::vz3 x)))
    (3dm.f::vec3 (list (3dm.f::vx3 x) (3dm.f::vy3 x) (3dm.f::vz3 x)))
    (3dm.f::mat3 (coerce (3dm.f::marr3 x) 'list))
    (3dm.d::mat4 (coerce (3dm.d::marr4 x) 'list))
    (3dm.d::vec4 (list (3dm.d::vx4 x) (3dm.d::vy4 x) (3dm.d::vz4 x) (3dm.d::vw4 x)))
    (3dm.f::vec4 (list (3dm.f::vx4 x) (3dm.f::vy4 x) (3dm.f::vz4 x) (3dm.f::vw4 x)))
    (3dm.f::mat4 (coerce (3dm.f::marr4 x) 'list))
    (array (loop for i below (array-total-size x) collect (row-major-aref x i)))))

(defun same-result-p (a b)
  (and (equal (type-of a) (type-of b))
       (or (not (arrayp a)) (and (equal (array-dimensions a) (array-dimensions b))
                                (equal (array-element-type a) (array-element-type b))))
       (let ((xs (components a)) (ys (components b)))
         (and (= (length xs) (length ys))
              (every (lambda (x y)
                       (<= (abs (- x y)) (* (if (typep x 'single-float) 1e-6 1d-12)
                                              (max 1 (abs x) (abs y))))) xs ys)))))

(defun check-pair (a b)
  (let ((before-a (components a)) (before-b (components b)))
    (assert (same-result-p (3dm:m* a b) (m* a b)))
    (assert (equal before-a (components a)))
    (assert (equal before-b (components b)))))

(defun run-tests ()
  (dolist (pair '((3dm.d::mat2 3dm.d::vec2)
                    (3dm.d::vec2 3dm.d::mat2)
                    (3dm.d::mat2 3dm.f::vec2)
                    (3dm.f::vec2 3dm.d::mat2)
                    (3dm.f::mat2 3dm.f::vec2)
                    (3dm.f::vec2 3dm.f::mat2)
                    (3dm.d::mat2 3dm.d::mat2)
                    (3dm.f::mat2 3dm.f::mat2)
                    (3dm.d::mat2 3dm.f::mat2)
                    (3dm.d::mat3 3dm.d::vec3)
                    (3dm.d::vec3 3dm.d::mat3)
                    (3dm.d::mat3 3dm.f::vec3)
                    (3dm.f::vec3 3dm.d::mat3)
                    (3dm.f::mat3 3dm.f::vec3)
                    (3dm.f::vec3 3dm.f::mat3)
                    (3dm.d::mat4 3dm.d::vec4)
                    (3dm.d::vec4 3dm.d::mat4)
                    (3dm.d::mat4 3dm.f::vec4)
                    (3dm.f::vec4 3dm.d::mat4)
                    (3dm.f::mat4 3dm.d::vec4)
                    (3dm.d::vec4 3dm.f::mat4)
                    (3dm.f::mat4 3dm.f::vec4)
                    (3dm.f::vec4 3dm.f::mat4)
                    (3dm.d::mat4 3dm.d::mat4)
                    (3dm.f::mat4 3dm.f::mat4)
                    (3dm.d::mat4 3dm.f::mat4)
                    (3dm.f::mat4 3dm.d::mat4)))
    (dolist (seed '(-7 0 5))
      (check-pair (fixture (first pair) seed) (fixture (second pair) (+ seed 3)))))
  (dolist (a-type '(single-float double-float))
    (dolist (b-type '(single-float double-float))
      (dolist (dims '((2 3 4) (1 1 1) (2 0 3) (0 3 4) (2 3 0)))
        (destructuring-bind (m n p) dims
          (let ((a (make-array (list m n) :element-type a-type))
                (b (make-array (list n p) :element-type b-type)))
            (dotimes (i (array-total-size a)) (setf (row-major-aref a i) (coerce (- i 2) a-type)))
            (dotimes (i (array-total-size b)) (setf (row-major-aref b i) (coerce (/ (1+ i) 3) b-type)))
            (check-pair a b))))))
  (let ((a (fixture '3dm.d::mat4 1)) (b (fixture '3dm.f::mat4 2))
        (c (fixture '3dm.d::vec4 3)))
    (assert (eq a (m* a)))
    (assert (same-result-p (3dm:m* a b c) (m* a b c))))
  ;; Verify convention against an independently constructed non-symmetric matrix.
  ;; Use backing array directly because the legacy mat2 constructor writes e01 twice.
  (let ((a (3dm.d::%mat2)) (v (3dm.d::%vec2 5d0 7d0)))
    (replace (3dm.d::marr2 a) '(1d0 3d0 2d0 4d0))
    (assert (equal (components (m* a v)) '(19d0 43d0)))
    (assert (equal (components (m* v a)) '(19d0 43d0))))
  (let ((a (make-array '(2 3) :element-type 'double-float :initial-element 1d0))
        (b (make-array '(2 2) :element-type 'double-float :initial-element 1d0)))
    (assert (handler-case (progn (m* a b) nil) (error () t))))
  ;; The fallback retains the general numeric/rational array path.
  (check-pair (make-array '(1 2) :initial-contents '((1/3 2/3)))
              (make-array '(2 1) :initial-contents '((3) (6))))
  (format t "~&Coalton multiplication regression checks passed.~%")
  t)

(defun benchmark (&optional (iterations 100000))
  (let ((a (fixture '3dm.d::mat4 1)) (b (fixture '3dm.d::mat4 2)))
    (format t "~&Legacy CL, dynamic public call:~%")
    (time (loop repeat iterations for result = (3dm:m* a b) finally (return result)))
    (format t "~&Coalton, dynamic public call:~%")
    (time (loop repeat iterations for result = (m* a b) finally (return result)))))
