                  (replace data (list (coerce (/ (+ seed 1) 1) 'double-float) (coerce (/ (+ seed 2) 2) 'double-float) (coerce (/ (+ seed 3) 3) 'double-float) (coerce (/ (+ seed 4) 1) 'double-float))) m))
    (3dm.d::vec2 (3dm.d::%vec2 (coerce (/ (+ seed 1) 1) 'double-float) (coerce (/ (+ seed 2) 2) 'double-float)))
    (3dm.f::vec2 (3dm.f::%vec2 (coerce (/ (+ seed 1) 1) 'single-float) (coerce (/ (+ seed 2) 2) 'single-float)))
    (3dm.f::mat2 (let* ((m (3dm.f::%mat2)) (data (3dm.f::marr2 m)))
                  (replace data (list (coerce (/ (+ seed 1) 1) 'single-float) (coerce (/ (+ seed 2) 2) 'single-float) (coerce (/ (+ seed 3) 3) 'single-float) (coerce (/ (+ seed 4) 1) 'single-float))) m))
    (3dm.d::mat3 (let* ((m (3dm.d::%mat3)) (data (3dm.d::marr3 m)))
                  (replace data (list (coerce (/ (+ seed 1) 1) 'double-float) (coerce (/ (+ seed 2) 2) 'double-float) (coerce (/ (+ seed 3) 3) 'double-float) (coerce (/ (+ seed 4) 1) 'double-float) (coerce (/ (+ seed 5) 2) 'double-float) (coerce (/ (+ seed 6) 3) 'double-float) (coerce (/ (+ seed 7) 1) 'double-float) (coerce (/ (+ seed 8) 2) 'double-float) (coerce (/ (+ seed 9) 3) 'double-float))) m))
    (3dm.d::vec3 (3dm.d::%vec3 (coerce (/ (+ seed 1) 1) 'double-float) (coerce (/ (+ seed 2) 2) 'double-float) (coerce (/ (+ seed 3) 3) 'double-float)))
    (3dm.f::vec3 (3dm.f::%vec3 (coerce (/ (+ seed 1) 1) 'single-float) (coerce (/ (+ seed 2) 2) 'single-float) (coerce (/ (+ seed 3) 3) 'single-float)))
    (3dm.f::mat3 (let* ((m (3dm.f::%mat3)) (data (3dm.f::marr3 m)))
                  (replace data (list (coerce (/ (+ seed 1) 1) 'single-float) (coerce (/ (+ seed 2) 2) 'single-float) (coerce (/ (+ seed 3) 3) 'single-float) (coerce (/ (+ seed 4) 1) 'single-float) (coerce (/ (+ seed 5) 2) 'single-float) (coerce (/ (+ seed 6) 3) 'single-float) (coerce (/ (+ seed 7) 1) 'single-float) (coerce (/ (+ seed 8) 2) 'single-float) (coerce (/ (+ seed 9) 3) 'single-float))) m))
    (3dm.d::mat4 (let* ((m (3dm.d::%mat4)) (data (3dm.d::marr4 m)))
                  (replace data (list (coerce (/ (+ seed 1) 1) 'double-float) (coerce (/ (+ seed 2) 2) 'double-float) (coerce (/ (+ seed 3) 3) 'double-float) (coerce (/ (+ seed 4) 1) 'double-float) (coerce (/ (+ seed 5) 2) 'double-float) (coerce (/ (+ seed 6) 3) 'double-float) (coerce (/ (+ seed 7) 1) 'double-float) (coerce (/ (+ seed 8) 2) 'double-float) (coerce (/ (+ seed 9) 3) 'double-float) (coerce (/ (+ seed 10) 1) 'double-float) (coerce (/ (+ seed 11) 2) 'double-float) (coerce (/ (+ seed 12) 3) 'double-float) (coerce (/ (+ seed 13) 1) 'double-float) (coerce (/ (+ seed 14) 2) 'double-float) (coerce (/ (+ seed 15) 3) 'double-float) (coerce (/ (+ seed 16) 1) 'double-float))) m))
    (3dm.d::vec4 (3dm.d::%vec4 (coerce (/ (+ seed 1) 1) 'double-float) (coerce (/ (+ seed 2) 2) 'double-float) (coerce (/ (+ seed 3) 3) 'double-float) (coerce (/ (+ seed 4) 1) 'double-float)))
    (3dm.f::vec4 (3dm.f::%vec4 (coerce (/ (+ seed 1) 1) 'single-float) (coerce (/ (+ seed 2) 2) 'single-float) (coerce (/ (+ seed 3) 3) 'single-float) (coerce (/ (+ seed 4) 1) 'single-float)))
    (3dm.f::mat4 (let* ((m (3dm.f::%mat4)) (data (3dm.f::marr4 m)))
                  (replace data (list (coerce (/ (+ seed 1) 1) 'single-float) (coerce (/ (+ seed 2) 2) 'single-float) (coerce (/ (+ seed 3) 3) 'single-float) (coerce (/ (+ seed 4) 1) 'single-float) (coerce (/ (+ seed 5) 2) 'single-float) (coerce (/ (+ seed 6) 3) 'single-float) (coerce (/ (+ seed 7) 1) 'single-float) (coerce (/ (+ seed 8) 2) 'single-float) (coerce (/ (+ seed 9) 3) 'single-float) (coerce (/ (+ seed 10) 1) 'single-float) (coerce (/ (+ seed 11) 2) 'single-float) (coerce (/ (+ seed 12) 3) 'single-float) (coerce (/ (+ seed 13) 1) 'single-float) (coerce (/ (+ seed 14) 2) 'single-float) (coerce (/ (+ seed 15) 3) 'single-float) (coerce (/ (+ seed 16) 1) 'single-float))) m))
