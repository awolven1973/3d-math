(defun unroll-axb (rows-a cols-a cols-b)
  (loop for i from 0 below rows-a
	append (loop for j from 0 below cols-b
		     collect `(setf (g ,i ,j)
				    (+ ,@(loop for k from 0 below cols-a 
					       collect `(* (e ,i ,k) (f ,k ,j))))))))

