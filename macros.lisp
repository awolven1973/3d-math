(eval-when (:compile-toplevel :load-toplevel :execute)
  (defvar *matrix-limit* (min (floor (sqrt array-dimension-limit))
                              (floor (sqrt most-positive-fixnum)))))

(deftype mat-dim ()
  '(integer 0 #.(1- *matrix-limit*)))

(defstruct (3dm::%matn)
  (3dm::mrows NIL :type mat-dim)
  (3dm::mcols NIL :type mat-dim))  

(defmacro define-matn-type (element-type)
  `(defstruct (,(intern "MATN" *package*) (:conc-name NIL)
	       (:include 3dm::%matn)
	       (:constructor ,(intern "%MATN" *package*) (3dm::mrows 3dm::mcols ,(intern "MARRN" *package*)))
	       (:copier NIL)
	       (:predicate ,(intern "MATN-P" *package*)))
     (,(intern "MARRN" *package*) NIL :type (simple-array ,element-type))))

(defmacro define-matn-constructor (element-type)
  `(progn
     (define-ofun ,(intern "MATN" *package*) (3dm::r 3dm::c &optional 3dm::elements)
       (check-type 3dm::r mat-dim)
       (check-type 3dm::c mat-dim)
       (if (= 3dm::r 3dm::c)
             (case 3dm::r
               (2 (apply #',(intern "MAT2" *package*) 3dm::elements))
               (3 (apply #',(intern "MAT3" *package*) 3dm::elements))
               (4 (apply #',(intern "MAT4" *package*) 3dm::elements))
               (T (,(intern "%MATN" *package*) 3dm::r 3dm::r (%proper-array (* 3dm::r 3dm::c) 3dm::elements ,element-type))))
             (,(intern "%MATN" *package*) 3dm::r 3dm::c (%proper-array (* 3dm::r 3dm::c) 3dm::elements ,element-type))))))

