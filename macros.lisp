       ,@(when mat3
           `((,',(intern "MAT3" *package*) (,',(intern "WITH-FAST-MATREF" *package*) (,3dm::accessor ,3dm::mat 3)
                     ,@mat3))))
       ,@(when mat4
           `((,',(intern "MAT4" *package*) (,',(intern "WITH-FAST-MATREF" *package*) (,3dm::accessor ,3dm::mat 4)
                     ,@mat4))))
       ,@(when matn
