(defmacro define-with-fast-matcase ()
  `(defmacro ,(intern "WITH-FAST-MATCASE" *package*) ((3dm::accessor 3dm::mat) &body 3dm::body)
  (let ((mat2 (cdr (assoc ',(intern "MAT2" *package*) 3dm::body)))
        (mat3 (cdr (assoc ',(intern "MAT3" *package*) 3dm::body)))
        (mat4 (cdr (assoc ',(intern "MAT4" *package*) 3dm::body)))
        (matn (cdr (assoc ',(intern "MATN" *package*) 3dm::body))))
    `(etypecase ,3dm::mat
       ,@(when mat2
           `((,',(intern "MAT2" *package*) (,',(intern "WITH-FAST-MATREF" *package*) (,3dm::accessor ,3dm::mat 2)
