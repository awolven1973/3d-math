(defmacro define-quat-from-zx-vectors-macro (element-type pkg)
  `(defmacro ,(intern "QUAT-FROM-ZX-VECTORS" pkg) (z-vector x-ish-vector)
     (let ((z-vector-sym (gensym)))
       `(let* ((,z-vector-sym ,z-vector)
	       (v-vector (3dm::orthogonalize ,z-vector-sym ,x-ish-vector))
	       (n (3dm::vunit ,z-vector-sym))
	       (v (3dm::vunit v-vector))
	       (u (3dm::vc v n))
	       (w)
	       (x)
	       (y)
	       (z)
	       (tr (+ ,,(mycoerce 1 element-type) (3dm::vx u) (3dm::vy v) (3dm::vz n))))
	  (if (> tr ,,(mycoerce 0 element-type))
  	      (let ((s (* ,,(mycoerce 2 element-type) (sqrt tr))))
  		(setf w (/ s ,,(mycoerce 4 element-type))
  		      x (/ (- (3dm::vz v) (3dm::vy n)) s)
  		      y (/ (- (3dm::vx n) (3dm::vz u)) s)
  		      z (/ (- (3dm::vy u) (3dm::vx v)) s)))
  	      (if (and (> (3dm::vx u) (3dm::vy v))
  		       (> (3dm::vx u) (3dm::vz n)))
  		  (let ((s (* ,,(mycoerce 2 element-type) (sqrt (- (+ ,,(mycoerce 1 element-type) (3dm::vx u)) (3dm::vy v) (3dm::vz n))))))
  		    (setf w (/ (- (3dm::vz v) (3dm::vy n)) s)
  			  x (/ s ,,(mycoerce 4 element-type))
  			  y (/ (- (3dm::vy u) (3dm::vx v)) s)
  			  z (/ (- (3dm::vx n) (3dm::vz u)) s)))
  		  (if (> (3dm::vy v) (3dm::vz n))
  		      (let ((s (* ,,(mycoerce 2 element-type) (sqrt (- (1+ (3dm::vy v)) (3dm::vx u) (3dm::vz n))))))
  			(setf w (/ (- (3dm::vx n) (3dm::vz u)) s)
  			      x (/ (- (3dm::vy u) (3dm::vx v)) s)
  			      y (/ s ,,(mycoerce 4 element-type))
  			      z (/ (- (3dm::vz v) (3dm::vy n)) s)))
  		      (let ((s (* ,,(mycoerce 2 element-type) (sqrt (- (1+ (3dm::vz n)) (3dm::vx u) (3dm::vy v))))))
  			(setf w (/ (- (3dm::vy u) (3dm::vx v)) s)
  			      x (/ (- (3dm::vx n) (3dm::vz u)) s)
  			      y (/ (- (3dm::vz v) (3dm::vy n)) s)
  			      z (/ s ,,(mycoerce 4 element-type)))))))
	  (,',(intern "%QUAT" pkg) x y z w)))))

