(defmacro define-quaternion-from-to-macro (r-pkg r-type)
  `(defmacro ,(intern "QUATERNION-FROM-TO" r-pkg) (from to)
     ;;https://subscription.packtpub.com/book/business-and-other/9781800208087/4/ch04lvl1sec29/creating-quaternions
     (let ((zero ,(mycoerce 0 r-type))
	   (one ,(mycoerce 1 r-type)))
       `(let ((from (3dm::vunit ,from))
	      (to (3dm::vunit ,to)))
	  (if (3dm::v= from to)
	      (,',(intern "%QUAT" r-pkg) ,zero ,zero ,zero ,one)
	      (if (3dm::v= from (3dm::v- to))
		  (let ((ortho))
		    (cond ((< (abs (3dm::vy from)) (abs (3dm::vx from)))
			   (setq ortho (,',(intern "VEC3" r-pkg) ,zero ,one ,zero)))
			  ((and (< (abs (3dm::vz from)) (abs (3dm::vy from)))
				(< (abs (3dm::vz from)) (abs (3dm::vx from))))
			   (setq ortho (,',(intern "VEC3" r-pkg) ,zero ,zero ,one)))
			  (t (setq ortho (,',(intern "VEC3" r-pkg) ,one ,zero ,zero))))
		    (let ((axis (3dm::vunit (3dm::vc from ortho))))
		      (,',(intern "%QUAT" r-pkg) (3dm::vx axis) (3dm::vy axis) (3dm::vz axis) ,zero)))
		  (let* ((half (3dm::vunit (3dm::v+ from to)))
			 (axis (3dm::vc from half)))
		    (,',(intern "%QUAT" r-pkg) (3dm::vx axis) (3dm::vy axis) (3dm::vz axis) (3dm::v. from half)))))))))

