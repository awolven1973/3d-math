(defmacro define-do-mat-diag-macro ()
  `(defmacro ,(intern "DO-MAT-DIAG" *package*) ((3dm::i 3dm::el 3dm::mat &optional 3dm::result) &body 3dm::body)
     (let ((arr (gensym "ARRAY"))
           (s (gensym "SIZE"))
           (m (gensym "MATRIX"))
           (iter (gensym "ITERATOR")))
       `(flet ((,iter (,arr ,s)
		 (dotimes (,3dm::i ,s ,3dm::result)
                   (declare (ignorable ,3dm::i))
                   (symbol-macrolet ((,3dm::el (aref ,arr (+ ,3dm::i (* ,3dm::i ,s)))))
                     ,@3dm::body))))
	  (declare (inline ,iter))
	  (let ((,m ,3dm::mat))
            (etypecase ,m
              (,(intern "MAT2" *package*) (,iter (,(intern "MARR2" *package*) ,m) 2))
              (,(intern "MAT3" *package*) (,iter (,(intern "MARR3" *package*) ,m) 3))
              (,(intern "MAT4" *package*) (,iter (,(intern "MARR4" *package*) ,m) 4))
              (,(intern "MATN" *package*) (,iter (,(intern "MARRN" *package*) ,m) (min (3dm::mrows ,m) (3dm::mcols ,m))))))))))

