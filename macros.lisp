(defmacro define-with-fast-matref (element-type)
  `(defmacro ,(intern "WITH-FAST-MATREF" *package*) ((3dm::accessor 3dm::mat 3dm::width) &body 3dm::body)
     (let ((w (gensym "WIDTH")) (arr (gensym "ARRAY"))
           (x (gensym "X")) (y (gensym "Y")))
       `(let ((,w ,3dm::width)
              (,arr (,(case 3dm::width
			(2 ',(intern "MARR2" *package*))
