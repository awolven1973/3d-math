(defmacro define-matrix-from-quaternion-macro (q-element-type)
  `(defmacro ,(intern "MATRIX-FROM-QUATERNION" *package*) (q)
     (let ((q-sym (gensym "QUAT"))
	   (zero ,(mycoerce 0 q-element-type))
	   (one ,(mycoerce 1 q-element-type))
	   (two ,(mycoerce 2 q-element-type)))
       `(let* ((,q-sym ,q)
	       (w (,',(intern "QW" *package*) ,q-sym))
	       (x (,',(intern "QX" *package*) ,q-sym))
	       (y (,',(intern "QY" *package*) ,q-sym))
